# DeepSeek OpenAI 兼容端点（换 Ollama/GPT 改这里即可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
TOKEN_BUDGET=4096

# MySQL（docker compose 起的库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=knowweave123
MYSQL_DB=knowweave
# 工具执行超时(秒)与重试次数
TOOL_TIMEOUT=5.0
TOOL_RETRIES=1

# 嵌入模型（硅基流动 OpenAI 兼容端点，BGE-M3 dense 1024 维）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-你的硅基流动密钥
EMBEDDING_MODEL=BAAI/bge-m3

# Milvus（docker compose 起的 standalone）
MILVUS_URI=http://127.0.0.1:19530

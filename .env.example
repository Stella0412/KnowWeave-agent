# DeepSeek OpenAI 兼容端点（换 Ollama/GPT 改这里即可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
TOKEN_BUDGET=4096

# MySQL（docker compose 起的库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=knowweave123
MYSQL_DB=knowweave
# 工具执行超时(秒)与重试次数
TOOL_TIMEOUT=5.0
TOOL_RETRIES=1

# 嵌入模型（硅基流动 OpenAI 兼容端点，BGE-M3 dense 1024 维）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-你的硅基流动密钥
EMBEDDING_MODEL=BAAI/bge-m3

# 重排模型（复用上面的硅基流动密钥；留空即自动复用 EMBEDDING_*）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=sk-你的硅基流动密钥

# Milvus：默认 Lite 内嵌（.db 文件，零额外容器；data/ 已 gitignore）
MILVUS_URI=data/milvus_knowledge.db
# 要并发/切 standalone 时改为：MILVUS_URI=http://127.0.0.1:19530

# ch06 意图识别（本章只落种子，不实现小模型升级）
INTENT_MODEL=
INTENT_SMALL_MODEL=
INTENT_MODE=accuracy
INTENT_CONF_THRESHOLD=0.7

# DeepSeek OpenAI 兼容端点（换 Ollama/GPT 改这里即可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
TOKEN_BUDGET=4096

# MySQL（docker compose 起的库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=knowweave123
MYSQL_DB=knowweave
# 工具执行超时(秒)与重试次数
TOOL_TIMEOUT=5.0
TOOL_RETRIES=1

# 嵌入模型（硅基流动 OpenAI 兼容端点，BGE-M3 dense 1024 维）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-你的硅基流动密钥
EMBEDDING_MODEL=BAAI/bge-m3

# 重排模型（复用上面的硅基流动密钥；留空即自动复用 EMBEDDING_*）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=sk-你的硅基流动密钥

# Milvus：默认 Lite 内嵌（.db 文件，零额外容器；data/ 已 gitignore）
MILVUS_URI=data/milvus_knowledge.db
# 要并发/切 standalone 时改为：MILVUS_URI=http://127.0.0.1:19530

# ch06 意图识别（本章只落种子，不实现小模型升级）
INTENT_MODEL=
INTENT_SMALL_MODEL=
INTENT_MODE=accuracy
INTENT_CONF_THRESHOLD=0.7

# ch07 上下文管理（三层上下文预算，单位除注明外均为 token）
MODEL_CONTEXT_WINDOW=64000
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
MAX_AGENT_STEPS=6
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=10
SYSTEM_PREFIX_RESERVE_TOKENS=1500
EVIDENCE_TOKENS_PER_CHUNK=200
SUMMARY_INJECT_MAX_TOKENS=1000
CONTEXT_SAFETY_MARGIN_TOKENS=1250
CONTEXT_TARGET_ROUNDS=20
LAYER1_SHARE=0.7
STEADY_TURN_TOKENS=1200
CLASSIFIER_HISTORY_MAX_TOKENS=1200
LAYER2_ASSISTANT_PREFIX_CHARS=60
ORDER_JSON_MAX_TOKENS=600
CJK_TOKENS_PER_CHAR=0.6
TOKEN_ESTIMATE_FACTOR=1.15
SUMMARY_INPUT_MAX_TOKENS=6000
SUMMARY_MESSAGE_MAX_TOKENS=800
SUMMARY_TOOL_RESULT_MAX_TOKENS=400
SUMMARY_MAX_CHARS=200
SUMMARY_MAX_OUTPUT_TOKENS=400
SUMMARY_RETRY_COOLDOWN_SECONDS=60
LOG_FILE=log/app.log

# ch08 MCP 工具端点与本地授权配置（无密钥；供 Task 5 动态发现/授权消费）
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTER_SALES_URL=http://127.0.0.1:8102/mcp
TOOL_PERMISSIONS_PATH=config/tool_permissions.json
